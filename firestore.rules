rules_version = '2';

// These rules exist only so the Firestore emulator has something to load for
// the integration tests. This library ships no rules of its own, and nothing
// here is ever deployed - never point a real project at this file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

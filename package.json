{
  "name": "@nandorojo/swr-firestore",
  "version": "1.0.0",
  "description": "SWR React hooks for Firestore, that you can actually use in production, on every screen.",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node scripts/write-type-markers.mjs",
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "firebase",
    "firestore",
    "swr",
    "react",
    "hooks"
  ],
  "repository": "https://github.com/y-yagi/swr-firestore",
  "author": "Fernando Rojo <frojo@sas.upenn.edu> (https://github.com/nandorojo)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/y-yagi/swr-firestore/issues"
  },
  "homepage": "https://github.com/y-yagi/swr-firestore#readme",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.24.0",
  "dependencies": {},
  "peerDependencies": {
    "firebase": ">=10",
    "react": ">=17",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": "^12.18.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swr": "^2.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
